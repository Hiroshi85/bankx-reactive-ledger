          ] } }]
        },
        {
          "name": "404 - Account not found",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountNumber\": \"999-9999\",\n  \"type\": \"CREDIT\",\n  \"amount\": 1\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/transactions", "host": ["{{baseUrl}}"], "path": ["api", "transactions"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
            "pm.test('Error account_not_found', () => pm.expect(pm.response.json()).to.deep.eql({ error: 'account_not_found' }));"
          ] } }]
        },
        {
          "name": "400 - Amount must be positive",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountNumber\": \"001-0001\",\n  \"type\": \"DEBIT\",\n  \"amount\": 0\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/transactions", "host": ["{{baseUrl}}"], "path": ["api", "transactions"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
            "pm.test('Error validation_error', () => pm.expect(pm.response.json()).to.deep.eql({ error: 'validation_error' }));"
          ] } }]
        },
        {
          "name": "400 - Invalid transaction type",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountNumber\": \"001-0001\",\n  \"type\": \"TRANSFER\",\n  \"amount\": 1\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/transactions", "host": ["{{baseUrl}}"], "path": ["api", "transactions"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
            "pm.test('Error validation_error', () => pm.expect(pm.response.json()).to.deep.eql({ error: 'validation_error' }));"
          ] } }]
        }
      ]
    },
    {
      "name": "SSE - Run manually",
      "item": [
        {
          "name": "Listen transaction events",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "text/event-stream" }],
            "url": { "raw": "{{baseUrl}}/api/stream/transactions", "host": ["{{baseUrl}}"], "path": ["api", "stream", "transactions"] },
            "description": "Enviar este request manualmente y mantenerlo abierto. Desde otra pestaña, ejecutar cualquier transacción exitosa. Debe aparecer un evento `transaction`. No ejecutar esta carpeta con Collection Runner porque el stream no finaliza por sí solo."
          },
          "response": []
        }
      ]
    }
  ]
}
